[
    {
        "corsRuleName": "browserUploadFromExampleOrigin",
        "allowedOrigins": [
            "http://localhost:3000",
            "http://127.0.0.1:3000"
        ],
        "allowedHeaders": [
            "content-type"
        ],
        "allowedOperations": [
            "s3_get",
            "s3_put"
        ],
        "maxAgeSeconds": 3600
    }
]
