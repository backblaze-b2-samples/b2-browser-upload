extends layout

block content
  h2.my-3 Backblaze B2 Browser Upload Example

  div
    p.
      Choose a file to upload. The S3-compatible API response will be shown in the page.
    h3.my-1 Backblaze S3-Compatible API Upload
    p.
      Since S3 presigned URLs include the object key (filename), when you click "Upload",
      the front end code GETs a presigned URL from the back end, passing the filename, content type,
      content length, and an upload token in the Authorization header.
    p Presigned URL:
    p
      code#presignedUrl
    p Uploaded file URL:
    p
      code#publicUrl

  form#uploadForm
    .mb-3
      label.form-label(for='uploadTokenInput') Upload token
      input(type='password', autocomplete='off')#uploadTokenInput.form-control
    .mb-3
      input(type='file')#uploadFileInput.form-control
    .mb-3
      button(type='submit')#s3UploadFileButton.btn.btn-secondary.me-1 Upload

  p#resultMessage

  pre#response

  script(src='/javascripts/index.js')
