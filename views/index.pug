extends layout

block content
  h2.my-3 Backblaze B2 Browser Upload Example

  div
    p.
      Choose a file to upload. The response from B2 will be shown in the page.
    h3.my-1 Backblaze S3-Compatible API Upload
    p.
      Since S3 presigned URLs include the object key (filename), when you click "Upload",
      the front end code GETs a presigned URL from the back end, passing the filename as a query parameter.
    p Presigned URL:
    p
      code#presignedUrl
    p Uploaded file URL:
    p
      code#publicUrl

  form
    .mb-3
      input(type='file')#uploadFileInput.form-control
    .mb-3
      button(type='submit')#s3UploadFileButton.btn.btn-secondary.me-1 Upload

  p#resultMessage

  pre#response

  script(src='/javascripts/index.js')
